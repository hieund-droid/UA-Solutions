# hq-apero-template — root .cursorignore
# Same intent as .claudeignore — applies to Cursor across the whole repo.

# === Secrets / credentials ===
.env
.env.*
*.pem
*.key
*.p12
service-account*.json
credentials.json
secrets/

# === Lockfiles ===
package-lock.json
pnpm-lock.yaml
yarn.lock
uv.lock
poetry.lock

# === Build artifacts ===
node_modules/
dist/
dist-ssr/
build/
.next/
.venv/
venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
coverage/
htmlcov/

# === Vendored / generated ===
vendor/
*.min.js
*.min.css

# === Runtime state (key-value JSON — see CLAUDE.md "Storage") ===
output/
