{
  "//": "Recommended user-level Claude Code settings. Merge into ~/.claude/settings.json. The plugin's hooks.json layers on top of these.",
  "permissions": {
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -fr /*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard origin/main*)",
      "Bash(sudo*)",
      "Bash(chmod 777*)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(wget * | bash)",
      "Bash(pip install --index-url*)",
      "Bash(pip install git+*)",
      "Bash(npm install --registry*)",
      "Bash(pnpm install --registry*)",
      "Bash(yarn install --registry*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(**/secrets/**)",
      "Read(service-account*.json)",
      "Read(credentials.json)"
    ]
  }
}
