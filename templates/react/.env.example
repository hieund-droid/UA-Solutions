# Apero React app — local dev env.
# REMINDER: anything VITE_* is PUBLIC. It gets baked into the bundle that ships to users.
# Do NOT put API keys, service tokens, or signing secrets here.

VITE_APP_NAME=apero-app
VITE_APP_ENV=local

# Logging level: debug | info | warn | error
VITE_LOG_LEVEL=info

# Public URL of the backend you call.
VITE_API_BASE_URL=http://localhost:3000

# SSO public config (issuer + client_id are public; client_secret never lives in the browser).
VITE_APERO_SSO_ISSUER=https://sso.apero.vn
VITE_APERO_SSO_CLIENT_ID=replace-me
