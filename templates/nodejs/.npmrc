# Apero internal npm registry (artifact-keeper, security-scanned).
registry=https://artifact-keeper.aperogroup.ai/api/v1/repositories/npm-proxy/download/
# Strict-ssl on; do NOT disable.
strict-ssl=true
# Always use exact versions when installing (no caret/tilde drift)
save-exact=false
# pnpm: refuse to install if lockfile would change
# (uncomment in CI; for local dev allow updates)
# frozen-lockfile=true
