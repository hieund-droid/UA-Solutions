# Tell Claude Code (and any tool that respects .claudeignore) what NOT to read.
# Goal: keep the AI from accidentally reading or echoing secrets / large
# build artifacts / vendored code.

# Secrets and credentials — never read
.env
.env.*
*.pem
*.key
*.p12
service-account*.json
credentials.json
secrets/

# Lockfiles — readable but rarely useful, big tokens
package-lock.json
pnpm-lock.yaml
yarn.lock
uv.lock
poetry.lock

# Build artifacts / dependency trees
node_modules/
dist/
build/
.next/
.venv/
venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
coverage/

# Vendored / generated
vendor/
*.min.js
*.min.css

# Runtime state (key-value JSON — see CLAUDE.md "Storage")
output/
